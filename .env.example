# HERMES Build Configuration Template
# Copy this file to .env and customize the values for your device
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   source .env && ./build.sh upload
#
# Note: .env is in .gitignore and will not be committed

# ============================================================================
# Room Configuration
# ============================================================================
export ROOM_NAME="Living Room"

# ============================================================================
# WiFi Configuration
# ============================================================================
export WIFI_SSID="your-wifi-ssid"
export WIFI_PASSWORD="your-wifi-password"

# ============================================================================
# MQTT Configuration (Home Assistant)
# ============================================================================
export MQTT_BROKER="your-mqtt-broker-ip"
export MQTT_PORT="1883"
export MQTT_USERNAME="homeassistant"
export MQTT_PASSWORD="your-mqtt-password"

# ============================================================================
# AI Services Configuration (for future use)
# These are used when audio features are enabled
# ============================================================================
export OLLAMA_HOST="http://your-server-ip:11434"
export PIPER_HOST="http://your-server-ip:10200"
export HA_HOST="http://your-server-ip:8123"
